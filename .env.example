# REQUIRED: Authentication
# Generate a secure JWT secret with: openssl rand -base64 32
JWT_SECRET=your-secret-jwt-key-here-min-32-chars-required
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-admin-password-min-8-chars

# OPTIONAL: Analytics & SEO
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# OPTIONAL: Search Engine Verification
NEXT_PUBLIC_GOOGLE_VERIFICATION=your-google-verification-code
NEXT_PUBLIC_BING_VERIFICATION=your-bing-verification-code
NEXT_PUBLIC_YANDEX_VERIFICATION=your-yandex-verification-code

# OPTIONAL: Error Tracking (free alternatives listed)
# Option 1: Google Analytics (free) - errors will be sent as events
# Option 2: Vercel Analytics (free tier available)
# Option 3: LogRocket (free tier: 1,000 sessions/month)
# Option 4: Sentry (free tier: 5,000 errors/month)
# NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn-here

# NOTE: Vercel automatically provides these:
# NODE_ENV, VERCEL, VERCEL_ENV, VERCEL_URL
